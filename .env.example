# ---------------------------------------------------------------------------
# CreatorPilot — environment template
#
# Copy this file to .env and fill values locally:
#
#     cp .env.example .env
#
# .env is git-ignored. Never commit real keys, tokens or credentials.
# An empty value means "not configured yet"; nothing here is required by the
# foundation — each module turns on only what it needs.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME=CreatorPilot
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Database (defaults match docker-compose.yml) --------------------------
POSTGRES_USER=creatorpilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=creatorpilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://creatorpilot:change-me@localhost:5432/creatorpilot

# --- Cache and API-quota accounting (Redis) --------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
CACHE_DEFAULT_TTL_SECONDS=900
API_QUOTA_WINDOW_SECONDS=86400

# --- External signal sources (integration adapters) ------------------------
# Placeholders only. Real credentials are shared out of band, never in git.
YOUTUBE_API_KEY=
NEWS_API_KEY=
RSS_FEED_URLS=

# --- LLM providers (llm/ access layer) -------------------------------------
# No provider is wired yet. These are read server-side only and must never
# reach the browser or a committed file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Local artefact paths (git-ignored) ------------------------------------
DATA_DIR=var/data
MODEL_DIR=var/models
